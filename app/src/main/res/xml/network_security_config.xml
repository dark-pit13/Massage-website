<?xml version="1.0" encoding="utf-8"?>
<!-- The manager handles customer contact details, so the app refuses plain HTTP
     outright. Every request must go over TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
